# Copia este archivo a .env para pruebas locales.
# En Render, estas mismas variables van en Dashboard -> tu servicio -> Environment.

SUPABASE_URL=https://tuproyecto.supabase.co
SUPABASE_KEY=tu_clave_service_role_secret
# IMPORTANTE: usa la clave "service_role" (Settings -> API -> Project API
# keys), NUNCA la "anon" -- este backend es un servidor de confianza, no
# código de navegador. service_role ignora RLS por diseño; anon depende
# 100% de que RLS esté bien configurado. Nunca compartas esta clave ni la
# pongas en código que corra en el navegador (dashboard, frontend, etc.).

TELEGRAM_BOT_TOKEN=1234567890:AA...
TELEGRAM_WEBHOOK_SECRET=un-secreto-que-tu-inventes

FIRECRAWL_API_KEY=fc-...

# Pool de claves de Gemini — agrega tantas como quieras, cualquier nombre
# que empiece con GEMINI_KEY_ se detecta automáticamente
GEMINI_KEY_1=AQ....
GEMINI_KEY_2=AQ....
